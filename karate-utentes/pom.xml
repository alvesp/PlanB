<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>pt.karate</groupId>
    <artifactId>karate-utentes</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>karate-utentes</name>
    <description>Escola de karate: gestão de utentes (alunos e responsáveis) e de aprendizagens (graduações, temas e presenças)</description>

    <modules>
        <module>karate-outbox</module>
        <module>utentes-events</module>
        <module>aprendizagem-events</module>
        <module>utentes-service</module>
        <module>aprendizagem-service</module>
        <module>utentes-query-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <opensearch-java.version>2.19.0</opensearch-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pt.karate</groupId>
                <artifactId>karate-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pt.karate</groupId>
                <artifactId>utentes-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pt.karate</groupId>
                <artifactId>aprendizagem-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensearch.client</groupId>
                <artifactId>opensearch-java</artifactId>
                <version>${opensearch-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
